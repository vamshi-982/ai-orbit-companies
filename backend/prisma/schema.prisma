generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String
  industry    String
  website     String?
  logo        String?
  headquarters String?
  foundedYear Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}